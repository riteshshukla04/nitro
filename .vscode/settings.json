{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "prettier.requireConfig": true,
  "prettier.ignorePath": "config/format-ignore",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_path": "clang-format",
  "C_Cpp.clang_format_style": "file:${workspaceFolder}/config/.clang-format",
  "ktlint.version": "1.8.0",
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json][jsonc][markdown][mdx][yaml][css][scss][html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[c][cpp][objective-c][objective-cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode"
  },
  "[kotlin][kotlin-script]": {
    "editor.defaultFormatter": "rnoro.vscode-ktlint-formatter"
  }
}
