{
  "version": 1,
  "classes": {
    "Base": {
      "android": {
        "implementation": {
          "className": "HybridBase"
        },
        "language": "kotlin"
      },
      "ios": {
        "implementation": {
          "className": "HybridBase"
        },
        "language": "swift"
      }
    },
    "CppValueSource": {
      "android": {
        "allowMultipleImplementations": true,
        "language": "c++"
      },
      "ios": {
        "allowMultipleImplementations": true,
        "language": "c++"
      }
    },
    "SomeExternalObject": {
      "android": {
        "allowMultipleImplementations": true,
        "implementation": {
          "className": "HybridSomeExternalObject"
        },
        "language": "kotlin"
      },
      "ios": {
        "allowMultipleImplementations": true,
        "implementation": {
          "className": "HybridSomeExternalObject"
        },
        "language": "swift"
      }
    }
  }
}
